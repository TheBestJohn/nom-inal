# Copy to .env and fill in before running `docker compose up`.

# --- required ---------------------------------------------------------------
# Password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me-to-something-long

# Signs session tokens. Anyone holding this can mint a token for any account.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- optional ---------------------------------------------------------------
POSTGRES_USER=nominal
POSTGRES_DB=nominal

# Host port the web UI is served on.
WEB_PORT=8088

# Which published image to run. Pin this to a released version rather than
# leaving it on `latest` if you want upgrades to be a decision you make.
NOM_INAL_VERSION=latest

# How long a session lasts, in hours (default one week).
JWT_TTL_HOURS=168

# USDA FoodData Central API key — free from https://fdc.nal.usda.gov/api-key-signup
# Without it, USDA search is skipped and Open Food Facts (which needs no key,
# and is the barcode source) still works.
USDA_API_KEY=

# Whether anyone can create an account. Like FOOD_QUORUM below, this only seeds
# a fresh install: the live toggle is in the admin area, and once an
# administrator has saved it this variable is ignored. The first account on an
# empty instance is always allowed, so `false` can never lock you out.
ALLOW_REGISTRATION=true

# Largest photo accepted per upload, before the server downscales it.
MAX_UPLOAD_MB=15

# The address this instance is reached at from outside, e.g.
# https://nom.example — used only by a shared recipe's page, whose Open Graph
# tags and canonical link have to be absolute URLs. Leave it empty and the
# page takes the origin from the request, which the bundled nginx forwards
# correctly; set it if you put your own proxy in front and it does not, or if
# the name it forwards is not the one people see.
PUBLIC_ORIGIN=

# Starting value for the verification quorum: how many net confirmations a
# food's current numbers need before the entry counts as verified. On a
# single-user instance set this to 1 — a second opinion that can never arrive
# just means nothing is ever verified.
#
# This only seeds a fresh install. The live value is changed from the admin
# area, and once an administrator has saved one this variable is ignored, so a
# restart cannot quietly undo them.
FOOD_QUORUM=2

RUST_LOG=nom_inal=info,tower_http=info,sqlx=warn
